{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-session-grep.dev/schemas/robot/v1/envelope.schema.json",
  "title": "agent-session-grep Robot Protocol Envelope v1",
  "description": "A complete agent-session-grep JSON or JSONL protocol frame.",
  "oneOf": [
    { "$ref": "#/$defs/success" },
    { "$ref": "#/$defs/error" },
    { "$ref": "#/$defs/progress" },
    { "$ref": "#/$defs/diagnostic" }
  ],
  "$defs": {
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["next_cursor", "has_more"],
      "properties": {
        "next_cursor": { "type": ["string", "null"] },
        "has_more": { "type": "boolean" }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duration_ms", "generation"],
      "properties": {
        "duration_ms": { "type": "integer", "minimum": 0 },
        "generation": { "type": ["integer", "string", "null"] }
      }
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "status", "ruleset_version", "redacted_count"],
      "properties": {
        "mode": { "enum": ["default", "revealed"] },
        "status": { "enum": ["applied", "none", "partial"] },
        "ruleset_version": { "type": "string", "maxLength": 64 },
        "redacted_count": { "type": "integer", "minimum": 0 },
        "audit_id": { "type": ["string", "null"], "maxLength": 128 }
      }
    },
    "errorBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable", "details"],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "invalid_request",
            "not_found",
            "source_io",
            "source_changed",
            "snapshot_failed",
            "catalog_error",
            "provider_error",
            "writer_busy",
            "schema_incompatible",
            "cursor_invalid",
            "cursor_expired",
            "generation_mismatch",
            "internal"
          ]
        },
        "message": { "type": "string", "maxLength": 4096 },
        "retryable": { "type": "boolean" },
        "details": {
          "type": "object",
          "maxProperties": 32,
          "additionalProperties": true
        }
      }
    },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "frame_type",
        "command",
        "request_id",
        "ok",
        "outcome",
        "data",
        "retrieval_mode",
        "redaction",
        "warnings",
        "page",
        "meta"
      ],
      "properties": {
        "schema_version": { "const": "1.0" },
        "frame_type": { "const": "response" },
        "command": { "type": "string", "minLength": 1, "maxLength": 64 },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "ok": { "const": true },
        "outcome": { "enum": ["success", "partial"] },
        "data": true,
        "retrieval_mode": {
          "enum": ["lexical", "semantic", "hybrid", "lexical_fallback"]
        },
        "redaction": { "$ref": "#/$defs/redaction" },
        "warnings": {
          "type": "array",
          "maxItems": 128,
          "items": { "type": "string", "maxLength": 4096 }
        },
        "page": { "$ref": "#/$defs/page" },
        "meta": { "$ref": "#/$defs/meta" }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "frame_type",
        "command",
        "request_id",
        "ok",
        "outcome",
        "error",
        "warnings",
        "page",
        "meta"
      ],
      "properties": {
        "schema_version": { "const": "1.0" },
        "frame_type": { "const": "error" },
        "command": { "type": "string", "minLength": 1, "maxLength": 64 },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "ok": { "const": false },
        "outcome": { "const": "failure" },
        "error": { "$ref": "#/$defs/errorBody" },
        "warnings": {
          "type": "array",
          "maxItems": 128,
          "items": { "type": "string", "maxLength": 4096 }
        },
        "page": { "$ref": "#/$defs/page" },
        "meta": { "$ref": "#/$defs/meta" }
      }
    },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "frame_type",
        "command",
        "request_id",
        "message"
      ],
      "properties": {
        "schema_version": { "const": "1.0" },
        "frame_type": { "const": "progress" },
        "command": { "type": "string", "minLength": 1, "maxLength": 64 },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "message": { "type": "string", "maxLength": 4096 }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "frame_type",
        "command",
        "request_id",
        "message"
      ],
      "properties": {
        "schema_version": { "const": "1.0" },
        "frame_type": { "const": "diagnostic" },
        "command": { "type": "string", "minLength": 1, "maxLength": 64 },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "message": { "type": "string", "maxLength": 4096 }
      }
    }
  }
}
