{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-session-grep.dev/schemas/robot/v1.1/envelope.schema.json",
  "title": "agent-session-grep Robot Protocol Envelope v1.1",
  "description": "A complete agent-session-grep JSON or JSONL protocol frame. Managed responses add bounded canonical provenance, snapshot and explicitly unverified freshness; legacy fields remain compatible.",
  "oneOf": [
    { "$ref": "#/$defs/success" },
    { "$ref": "#/$defs/error" },
    { "$ref": "#/$defs/progress" },
    { "$ref": "#/$defs/diagnostic" }
  ],
  "$defs": {
    "searchHit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "score", "session_id", "text", "resume_available"],
      "properties": {
        "id": { "type": "string" },
        "score": { "type": "number" },
        "session_id": { "type": ["string", "null"] },
        "text": { "type": ["string", "null"] },
        "why_matched": {
          "type": "array",
          "items": { "type": "string" },
          "maxItems": 8,
          "description": "Deterministic literal-term evidence derived from the query against the hit's full text."
        },
        "suggested_next_commands": {
          "type": "array",
          "items": { "type": "string" },
          "maxItems": 2,
          "description": "Suggested follow-up commands using only real identifiers present on the hit."
        },
        "occurrences": {
          "type": "integer",
          "minimum": 1,
          "description": "Per-session collapse count under group_by_session; always 1 on the default path, where the key is omitted to keep legacy output byte-compatible."
        },
        "resume_available": {
          "type": "boolean",
          "description": "Whether Resume Metadata is available for the hit's session (ADR-0009). false only means no resumable provider metadata exists; the history stays searchable."
        }
      }
    },
    "truncation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["truncated", "reason"],
      "properties": {
        "truncated": { "type": "boolean" },
        "reason": { "type": ["string", "null"] }
      }
    },
    "searchData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hits", "generation", "truncation"],
      "properties": {
        "hits": {
          "type": "array",
          "items": { "$ref": "#/$defs/searchHit" }
        },
        "generation": { "type": "integer", "minimum": 0 },
        "truncation": { "$ref": "#/$defs/truncation" },
        "facets": { "$ref": "#/$defs/searchFacets" },
        "provenance": { "$ref": "#/$defs/managedProvenance" },
        "snapshot": { "$ref": "#/$defs/managedSnapshot" },
        "freshness": { "$ref": "#/$defs/managedFreshness" }
      }
    },
    "managedProvenance": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entity_id", "provider_id", "session_id", "message_id", "placement_id", "document_id", "revision_digest", "precision", "related_revision_digests"],
        "properties": {
          "entity_id": { "type": "string", "pattern": "^(msg|ses|doc)_v1_", "maxLength": 256 },
          "provider_id": { "type": ["string", "null"], "maxLength": 64 },
          "session_id": { "type": ["string", "null"], "pattern": "^ses_v1_", "maxLength": 256 },
          "message_id": { "type": ["string", "null"], "pattern": "^msg_v1_", "maxLength": 256 },
          "placement_id": { "type": ["string", "null"], "maxLength": 256 },
          "document_id": { "type": ["string", "null"], "pattern": "^doc_v1_", "maxLength": 256 },
          "revision_digest": { "type": "string", "minLength": 1, "maxLength": 256 },
          "precision": { "enum": ["byte", "unknown"] },
          "related_revision_digests": {
            "type": "array", "maxItems": 1024, "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 256 }
          }
        }
      }
    },
    "managedSnapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["generation", "destructive_epoch", "policy_epoch"],
      "properties": {
        "generation": { "type": "integer", "minimum": 0 },
        "destructive_epoch": { "type": "integer", "minimum": 0 },
        "policy_epoch": { "type": "integer", "minimum": 0 }
      }
    },
    "managedFreshness": {
      "type": "object", "additionalProperties": false,
      "description": "Latest is proved by matching discovery and source receipts in the output snapshot. Generation and worker heartbeat are never freshness proof.",
      "required": ["coverage", "update_state", "latest_requested", "latest_satisfied", "reason", "selected_scopes", "complete_scopes", "contributing_sources", "verified_sources", "pending_sources", "failed_sources", "last_verified_observation_at_ms"],
      "properties": {
        "coverage": { "enum": ["empty", "partial", "complete"] },
        "update_state": { "enum": ["running", "idle", "paused", "stopped", "offline", "busy", "failed", "deferred", "upgrading"] },
        "latest_requested": { "type": "boolean" },
        "latest_satisfied": { "type": "boolean" },
        "reason": { "enum": ["verified", "as_of_verified", "discovery_pending", "paused", "stopped", "offline", "busy", "failed", "deferred", "upgrading", "policy_changed", "timeout", "scope_unverified", "source_changed", "worker_restarted", "catalog_changed", "rewrite_pending", "deletion_pending"] },
        "selected_scopes": { "type": "integer", "minimum": 0 },
        "complete_scopes": { "type": "integer", "minimum": 0 },
        "contributing_sources": { "type": "integer", "minimum": 0 },
        "verified_sources": { "type": "integer", "minimum": 0 },
        "pending_sources": { "type": "integer", "minimum": 0 },
        "failed_sources": { "type": "integer", "minimum": 0 },
        "last_verified_observation_at_ms": { "type": ["integer", "null"], "minimum": 0 }
      },
      "allOf": [{
        "if": { "properties": { "latest_satisfied": { "const": true } }, "required": ["latest_satisfied"] },
        "then": { "properties": { "latest_requested": { "const": true }, "coverage": { "const": "complete" }, "reason": { "const": "verified" } } }
      }]
    },
    "searchFacets": {
      "type": "object",
      "additionalProperties": false,
      "description": "Structured facet filters echoed back as applied. The key is omitted entirely when every facet holds its default (sidechain=include, no tool filters), keeping default output byte-compatible.",
      "properties": {
        "sidechain": { "enum": ["include", "main_only", "subagent_only"] },
        "tool_kind": {
          "enum": ["file", "command", "web", "query", "unknown", null],
          "description": "Closed tool-activity kind set; null means no tool_kind filter was applied."
        },
        "tool_name": {
          "type": ["string", "null"],
          "description": "Verbatim tool name filter; null means no tool_name filter was applied."
        }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["next_cursor", "has_more"],
      "properties": {
        "next_cursor": { "type": ["string", "null"] },
        "has_more": { "type": "boolean" }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duration_ms", "generation"],
      "properties": {
        "duration_ms": { "type": "integer", "minimum": 0 },
        "generation": { "type": ["integer", "string", "null"] }
      }
    },
    "errorBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable", "details"],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "invalid_request",
            "not_found",
            "source_io",
            "source_changed",
            "snapshot_failed",
            "catalog_error",
            "provider_error",
            "capability_not_supported",
            "writer_busy",
            "schema_incompatible",
            "cursor_invalid",
            "cursor_expired",
            "generation_mismatch",
            "internal"
          ]
        },
        "message": { "type": "string", "maxLength": 4096 },
        "retryable": { "type": "boolean" },
        "details": {
          "type": "object",
          "maxProperties": 32,
          "additionalProperties": true
        }
      }
    },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "frame_type",
        "command",
        "request_id",
        "ok",
        "outcome",
        "data",
        "retrieval_mode",
        "redaction",
        "warnings",
        "page",
        "meta"
      ],
      "properties": {
        "schema_version": { "const": "1.1" },
        "frame_type": { "const": "response" },
        "command": { "type": "string", "minLength": 1, "maxLength": 64 },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "ok": { "const": true },
        "outcome": { "enum": ["success", "partial"] },
        "data": true,
        "retrieval_mode": {
          "enum": ["lexical", "semantic", "hybrid", "lexical_fallback"]
        },
        "redaction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "status", "ruleset_version", "redacted_count"],
          "properties": {
            "mode": { "enum": ["default", "revealed"] },
            "status": { "enum": ["applied", "none", "partial"] },
            "ruleset_version": { "type": "string", "maxLength": 64 },
            "redacted_count": { "type": "integer", "minimum": 0 },
            "audit_id": { "type": ["string", "null"], "maxLength": 128 }
          }
        },
        "warnings": {
          "type": "array",
          "maxItems": 128,
          "items": { "type": "string", "maxLength": 4096 }
        },
        "page": { "$ref": "#/$defs/page" },
        "meta": { "$ref": "#/$defs/meta" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "command": { "const": "search" } },
            "required": ["command"]
          },
          "then": {
            "properties": {
              "data": { "$ref": "#/$defs/searchData" }
            }
          }
        },
        {
          "properties": {
            "data": {
              "if": { "type": "object", "required": ["snapshot"] },
              "then": {
                "type": "object",
                "required": ["provenance", "snapshot", "freshness"],
                "properties": {
                  "provenance": { "$ref": "#/$defs/managedProvenance" },
                  "snapshot": { "$ref": "#/$defs/managedSnapshot" },
                  "freshness": { "$ref": "#/$defs/managedFreshness" }
                }
              }
            }
          }
        }
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "frame_type",
        "command",
        "request_id",
        "ok",
        "outcome",
        "error",
        "warnings",
        "page",
        "meta"
      ],
      "properties": {
        "schema_version": { "const": "1.1" },
        "frame_type": { "const": "error" },
        "command": { "type": "string", "minLength": 1, "maxLength": 64 },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "ok": { "const": false },
        "outcome": { "const": "failure" },
        "error": { "$ref": "#/$defs/errorBody" },
        "warnings": {
          "type": "array",
          "maxItems": 128,
          "items": { "type": "string", "maxLength": 4096 }
        },
        "page": { "$ref": "#/$defs/page" },
        "meta": { "$ref": "#/$defs/meta" }
      }
    },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "frame_type",
        "command",
        "request_id",
        "message"
      ],
      "properties": {
        "schema_version": { "const": "1.1" },
        "frame_type": { "const": "progress" },
        "command": { "type": "string", "minLength": 1, "maxLength": 64 },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "message": { "type": "string", "maxLength": 4096 }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "frame_type",
        "command",
        "request_id",
        "message"
      ],
      "properties": {
        "schema_version": { "const": "1.1" },
        "frame_type": { "const": "diagnostic" },
        "command": { "type": "string", "minLength": 1, "maxLength": 64 },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "message": { "type": "string", "maxLength": 4096 }
      }
    }
  }
}
